# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string (recommended). `docker compose up -d` provides one.
DATABASE_URL=postgres://memecoin:memecoin@localhost:5433/memecoin
# Leave DATABASE_URL empty to use the embedded PGlite database at ./data/pglite
# (zero-dependency dev mode; forces WORKER_MODE=inprocess).

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# separate  -> run `npm run worker` as its own process (default with PostgreSQL)
# inprocess -> Next.js server runs the scheduler (required with PGlite)
WORKER_MODE=separate
# Discovery/refresh cadence in seconds. Lower values consume provider quota faster.
DISCOVERY_INTERVAL_SEC=90
REFRESH_INTERVAL_SEC=45
SECURITY_INTERVAL_SEC=600
# Maximum tokens kept "hot" (refreshed every cycle): launches < 15 min old first, then highest 1h volume.
# Everything else decays to the cold lane (60 tokens per cycle, each at most every 10 min).
HOT_TOKEN_LIMIT=200

# ---------------------------------------------------------------------------
# Auth (single-operator). If APP_PASSWORD is empty the app runs unauthenticated on localhost.
# ---------------------------------------------------------------------------
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL used in alert links (no trailing slash)
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Providers (all optional; keyless public endpoints are used by default)
# ---------------------------------------------------------------------------
# Solana RPC. Public endpoint throttles getTokenLargestAccounts; use Helius/QuickNode/Triton for reliable holder data.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Set to "false" to disable a provider entirely.
PROVIDER_JUPITER_ENABLED=true
PROVIDER_DEXSCREENER_ENABLED=true
PROVIDER_GECKOTERMINAL_ENABLED=true
PROVIDER_RUGCHECK_ENABLED=true
# Optional paid providers (not required). Leave empty to skip.
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Web Push (browser notifications while the tab is closed). Generate with `npm run push:keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Telegram bot (optional): create a bot with @BotFather, then message it and read chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord webhook URL (optional)
DISCORD_WEBHOOK_URL=
# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# ---------------------------------------------------------------------------
# Demo mode: when true, the worker is disabled, no provider is contacted and the UI labels everything
# as fixture data. Seed the labelled fixtures with `npm run db:seed-demo` (use a separate database).
# ---------------------------------------------------------------------------
DEMO_MODE=false
